# Ignore everything by default
*

# Allow this file so the rules persist
!.gitignore

# Allow the current working set of files
!LICENSE
!README.md
!bbs.csv
!config.json
!go.mod
!go.sum

# Go source files
!ansi_enhanced.go
!ansi_music.go
!api.go
!bbs_directory.go
!capture_manager.go
!config.go
!cp437_enhanced.go
!cp866.go
!directory_handlers.go
!legacy_processors.go
!main.go
!petscii_atascii.go
!proxy.go
!slug.go
!zmodem_lrzsz.go
!bbs_probe_test.go
!decoders_test.go
!cjk.go
!metrics.go
!metrics_test.go

# Charset configuration
!charset_bbs.csv

# Allow the static directory itself, but only whitelist specific files inside
!static/
!static/style.css
!static/index.html
!static/bbs.json
!static/auth.js
!static/zmodem-handler.js
!static/zmodem-integration.html
!static/zmodem.min.js
!static/zmodem-lib.js
!static/bbs_seed.json
!static/directory.js
!static/app.js
!static/ansi-music.js
!static/favicon.svg


# Allow GitHub Actions workflows
!.github/
!.github/workflows/
!.github/workflows/ci.yml

# Cloudflare Tunnel kit (see deploy/tunnel/README.md)
!deploy/
!deploy/tunnel/
!deploy/tunnel/README.md
!deploy/tunnel/compose.yaml
!deploy/tunnel/cloudflare.json
!deploy/tunnel/cloudflare.mjs

# Allow verification scripts
!verify_ansi_fix.sh

# Allow references directory for documentation
!references/
!references/*.md
!references/*.txt

# By default, everything else remains ignored
# Local debug artifacts
*.log
*.tmp
*.swp
*.DS_Store
node_modules/

# Shared Grafana on dellcon (see deploy/monitoring/README.md)
!deploy/monitoring/
!deploy/monitoring/README.md
!deploy/monitoring/retroterm.yml
!deploy/monitoring/retroterm.json
