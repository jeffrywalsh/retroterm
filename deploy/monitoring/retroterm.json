      "targets": [
        {
          "refId": "D",
          "expr": "count((increase(retroterm_board_connects_total{job=\"retroterm\"}[24h]) + (min_over_time(retroterm_board_connects_total{job=\"retroterm\"}[24h]) unless retroterm_board_connects_total{job=\"retroterm\"} offset 24h) or increase(retroterm_board_connects_total{job=\"retroterm\"}[24h])) > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 4
    },
    {
